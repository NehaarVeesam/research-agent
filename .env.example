QWEN_BASE_URL=http://localhost:8100/v1
QWEN_MODEL=replace-with-the-served-model-id
QWEN_API_KEY=

# Retrieval: local preserves the fictional examples; web uses external sources.
RESEARCH_BACKEND=local
WEB_SEARCH_PROVIDER=wikipedia
# Tavily is optional and requires its own key; no automatic provider fallback.
TAVILY_API_KEY=
WEB_ALLOWED_DOMAINS=en.wikipedia.org,docs.python.org,modelcontextprotocol.io,docs.langchain.com
WEB_MAX_RESULTS=3
WEB_TIMEOUT_SECONDS=15
WEB_MAX_BYTES=2000000
WEB_MAX_TEXT_CHARS=100000
